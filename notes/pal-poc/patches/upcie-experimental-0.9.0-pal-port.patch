-	tmp->attach = dma_buf_dynamic_attach(tmp->dma_buf, dev, &dmabuf_import_attach_ops, tmp);
+	tmp->attach = dmabuf_import_dynamic_attach(tmp->dma_buf, dev, &dmabuf_import_attach_ops, tmp);
 	if (IS_ERR(tmp->attach)) {
