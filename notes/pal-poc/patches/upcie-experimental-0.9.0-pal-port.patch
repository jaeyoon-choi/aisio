 			tmp->sgt = NULL;
diff --color -ruN a/dmabuf_import/Makefile b/dmabuf_import/Makefile
--- a/dmabuf_import/Makefile	2026-10-14 08:28:41.498795764 +0900
+++ b/dmabuf_import/Makefile	2026-10-14 08:28:41.499722404 +0900
@@ -9,6 +9,10 @@

 obj-m += dmabuf_import.o

+# The DMA-buf mapping types series renames the importer entry points. Detect
+# it by its header so the same source builds on both kernels.
+ccflags-y += $(if $(wildcard $(srctree)/include/linux/dma-buf-mapping.h),-DDMABUF_IMPORT_MAPPING_TYPES)
+
 KDIR ?= /lib/modules/$(shell uname -r)/build
 PWD  := $(shell pwd)
