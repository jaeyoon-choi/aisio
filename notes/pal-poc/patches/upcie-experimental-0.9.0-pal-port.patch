-			dma_buf_unmap_attachment(desc->attach, desc->sgt, desc->dir);
+			dmabuf_import_unmap_attachment(desc->attach, desc->sgt, desc->dir);
 		if (desc->pinned)
 			dma_buf_unpin(desc->attach);
 		dma_resv_unlock(desc->dma_buf->resv);
@@ -441,7 +460,7 @@
