# sid PAL PoC — 사용자 결정값 (2026-10-14)
# 접속: ssh jaeyoon@sid (비밀번호 인증) → sudo로 root 실행
#        (매뉴얼의 root 무비밀번호는 불가; jaeyoon 키 인증도 미등록)
SID=sid
SID_USER=jaeyoon
# 시험 장치 (사용자 선택): socket0 / RC 4a / 루트포트 4c:01.0, nvme2, 빈 장치
NVME=0000:4e:00.0
# 덮어쓸 시작 LBA (사용자 선택): 장치 선두, dev PC와 동일
SLBA=0
# 승인됨: apt 설치 flex bison pahole libcap-dev (section 3/5에서 사용)
# 절대 건드리지 않음: 0000:4d:00.0 (데이터셋)
